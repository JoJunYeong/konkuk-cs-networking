rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'uk5noSfHHMU3y9l7CPkG5F0YRl33';
    }

    function validShortString(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function validRegistrationId(registrationId) {
      return registrationId.matches('^[a-f0-9]{32}$');
    }

    function registrationGatePath(eventId) {
      return /databases/$(database)/documents/registrationGates/$(eventId);
    }

    function registrationPath(registrationId) {
      return /databases/$(database)/documents/registrations/$(registrationId);
    }

    function statsPath(eventId) {
      return /databases/$(database)/documents/registrationStats/$(eventId);
    }

    function countUpdatePath(eventId) {
      return /databases/$(database)/documents/registrationCountUpdates/$(eventId);
    }

    function validStats(data) {
      return data.keys().hasAll(['count', 'updatedAt'])
        && data.keys().hasOnly(['count', 'updatedAt'])
        && data.count is int && data.count >= 0
        && data.updatedAt == request.time;
    }

    function countIncreased(eventId) {
      return exists(statsPath(eventId))
        && getAfter(statsPath(eventId)).data.count == get(statsPath(eventId)).data.count + 1
        && getAfter(statsPath(eventId)).data.updatedAt == request.time;
    }

    function newRegistrationCounted(eventId, registrationId) {
      return validRegistrationId(registrationId)
        && !exists(registrationPath(registrationId))
        && getAfter(registrationPath(registrationId)).data.eventId == eventId
        && getAfter(registrationPath(registrationId)).data.status == 'payment_reported'
        && getAfter(countUpdatePath(eventId)).data.registrationId == registrationId
        && getAfter(countUpdatePath(eventId)).data.updatedAt == request.time
        && countIncreased(eventId);
    }

    function activeRegistration(data) {
      return data.status in ['payment_reported', 'confirmed'];
    }

    function countAdjusted(eventId, delta) {
      return !exists(statsPath(eventId))
        || (getAfter(statsPath(eventId)).data.count == get(statsPath(eventId)).data.count + delta
          && getAfter(statsPath(eventId)).data.updatedAt == request.time);
    }

    function validFee(amount) {
      return amount is int && amount > 0 && amount <= 1000000;
    }

    function validFeeSchedule(amounts) {
      return amounts is map
        && amounts.keys().hasAll(['student', 'graduate'])
        && amounts.keys().hasOnly(['student', 'graduate'])
        && validFee(amounts.student) && validFee(amounts.graduate);
    }

    function registrationFeeMatches(data, gate) {
      return gate.keys().hasAny(['paymentAmounts'])
        ? validFeeSchedule(gate.paymentAmounts)
          && data.keys().hasAll(['participantType'])
          && data.participantType in ['student', 'graduate']
          && data.amount == gate.paymentAmounts[data.participantType]
        : data.amount == gate.amount
          && (!data.keys().hasAny(['participantType']) || data.participantType in ['student', 'graduate']);
    }

    function validGateFees(data) {
      return !data.keys().hasAny(['paymentAmounts'])
        || (data.paymentAmounts is map
          && data.paymentAmounts.keys().hasAll(['student', 'graduate'])
          && data.paymentAmounts.keys().hasOnly(['student', 'graduate'])
          && data.paymentAmounts.student is int
          && data.paymentAmounts.graduate is int
          && data.paymentAmounts.student >= 0 && data.paymentAmounts.student <= 1000000
          && data.paymentAmounts.graduate >= 0 && data.paymentAmounts.graduate <= 1000000
          && (data.accepting != true || validFeeSchedule(data.paymentAmounts)));
    }

    function manualRegistrationOpen(data) {
      let eventId = data.eventId;
      return eventId is string
        && eventId.matches('^[0-9]{4}-Q[1-4]$')
        && exists(registrationGatePath(eventId))
        && get(registrationGatePath(eventId)).data.accepting == true
        && registrationDeadlineOpen(get(registrationGatePath(eventId)).data)
        && get(registrationGatePath(eventId)).data.mode == 'manual_transfer'
        && registrationFeeMatches(data, get(registrationGatePath(eventId)).data);
    }

    function validRegistrationDeadline(data) {
      return data.keys().hasAll(['registrationDeadline'])
        && (data.registrationDeadline == null || data.registrationDeadline is timestamp);
    }

    function registrationDeadlineOpen(data) {
      return validRegistrationDeadline(data)
        && (data.registrationDeadline == null || request.time < data.registrationDeadline);
    }

    match /siteData/{documentId} {
      allow read: if documentId == 'events' || documentId == 'history';
      allow create, update: if isAdmin()
        && (documentId == 'events' || documentId == 'history')
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt', 'updatedBy'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 500000;
      allow delete: if false;
    }

    // 관리자가 회차 저장 시 함께 갱신합니다. 공개 신청은 이 문서가 명시적으로
    // accepting=true인 자체 계좌이체 회차에만 생성할 수 있습니다.
    match /registrationGates/{eventId} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin() && validRegistrationDeadline(request.resource.data)
        && validGateFees(request.resource.data);
      allow update: if isAdmin() && validRegistrationDeadline(request.resource.data)
        && validGateFees(request.resource.data)
        && (!resource.data.keys().hasAny(['paymentAmounts']) || request.resource.data.keys().hasAll(['paymentAmounts']));
    }

    // 공개 문서에는 인원과 갱신 시각만 저장하며 신청번호나 개인정보를 넣지 않습니다.
    match /registrationStats/{eventId} {
      allow get: if eventId.matches('^[0-9]{4}-Q[1-4]$');
      allow list: if isAdmin();
      allow create: if isAdmin() && validStats(request.resource.data);
      allow update: if validStats(request.resource.data)
        && (isAdmin() || newRegistrationCounted(eventId, getAfter(countUpdatePath(eventId)).data.registrationId));
      allow delete: if false;
    }

    // 신청과 집계의 원자적 갱신을 증명하는 비공개 문서입니다.
    match /registrationCountUpdates/{eventId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasAll(['registrationId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['registrationId', 'updatedAt'])
        && newRegistrationCounted(eventId, request.resource.data.registrationId);
      allow delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if validRegistrationId(registrationId)
        && request.resource.data.keys().hasOnly([
          'eventId', 'eventQuarter', 'status', 'name', 'phone', 'phoneDigits',
          'depositorName', 'participantType', 'amount', 'paymentReported', 'privacyConsent',
          'consentVersion', 'createdAt', 'clientTimezone', 'source'
        ])
        && manualRegistrationOpen(request.resource.data)
        && validShortString(request.resource.data.eventQuarter, 40)
        && request.resource.data.status == 'payment_reported'
        && validShortString(request.resource.data.name, 40)
        && validShortString(request.resource.data.phone, 24)
        && request.resource.data.phoneDigits is string
        && request.resource.data.phoneDigits.matches('^01[0-9]{8,9}$')
        && validShortString(request.resource.data.depositorName, 40)
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.paymentReported == true
        && request.resource.data.privacyConsent == true
        && validShortString(request.resource.data.consentVersion, 40)
        && request.resource.data.createdAt == request.time
        && request.resource.data.clientTimezone is string
        && request.resource.data.clientTimezone.size() <= 80
        && request.resource.data.source == 'public_web'
        && (!exists(statsPath(request.resource.data.eventId))
          || newRegistrationCounted(request.resource.data.eventId, registrationId));
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.eventId == resource.data.eventId
        && (activeRegistration(resource.data) == activeRegistration(request.resource.data)
          || countAdjusted(resource.data.eventId, activeRegistration(request.resource.data) ? 1 : -1));
      allow delete: if isAdmin()
        && (!activeRegistration(resource.data) || countAdjusted(resource.data.eventId, -1));
    }

    match /refundRequests/{registrationId} {
      allow create: if validRegistrationId(registrationId)
        && exists(registrationPath(registrationId))
        && request.resource.data.keys().hasOnly([
          'registrationId', 'eventId', 'status', 'phoneDigits', 'refundBank',
          'refundAccount', 'refundAccountHolder', 'refundConsent', 'createdAt', 'source'
        ])
        && request.resource.data.registrationId == registrationId
        && request.resource.data.eventId == get(registrationPath(registrationId)).data.eventId
        && request.resource.data.phoneDigits == get(registrationPath(registrationId)).data.phoneDigits
        && get(registrationPath(registrationId)).data.status in ['payment_reported', 'confirmed']
        && request.resource.data.status == 'refund_requested'
        && request.resource.data.phoneDigits is string
        && request.resource.data.phoneDigits.matches('^01[0-9]{8,9}$')
        && validShortString(request.resource.data.refundBank, 30)
        && request.resource.data.refundAccount is string
        && request.resource.data.refundAccount.matches('^[0-9]{8,20}$')
        && validShortString(request.resource.data.refundAccountHolder, 40)
        && request.resource.data.refundConsent == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.source == 'public_web';
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
